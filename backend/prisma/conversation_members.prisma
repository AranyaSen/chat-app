enum MemberRole {
    OWNER
    MEMBER
}

model Conversation_Members {
    id              String     @id @default(uuid())
    conversation_id String
    user_id         String
    role            MemberRole @default(MEMBER)
    joined_at       DateTime   @default(now())
    left_at         DateTime?
    // last_message_read String?

    // relations
    user         Users         @relation(fields: [user_id], references: [id], onDelete: Restrict)
    conversation Conversations @relation(fields: [conversation_id], references: [id], onDelete: Cascade)

    @@unique([conversation_id, user_id])
    @@index([user_id])
}
